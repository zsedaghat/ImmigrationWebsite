@model ImmigrationWebsite.Web.Models.Pagination.PagedResult<ImmigrationWebsite.Web.Models.BlogPost>

@{
    ViewData["Title"] = "Blog Posts";
}

<div class="card">

    <div class="card-header">

        <div class="d-flex justify-content-between align-items-center w-100">

            <h3 class="card-title mb-0">
                Blog Posts
            </h3>

            <a asp-area="Admin"
               asp-controller="BlogPosts"
               asp-action="Create"
               class="btn btn-primary btn-sm">

                <i class="bi bi-plus-lg"></i>
                Add Blog Post

            </a>

        </div>

    </div>

    <div class="card-body">

        @if (!Model.Items.Any())
        {
            <p>No blog posts found.</p>
        }
        else
        {
            <table class="table table-bordered table-striped">

                <thead>
                    <tr>

                        <th>ID</th>

                        <th>Title</th>

                        <th style="width: 280px;">
                            Summary
                        </th>

                        <th>Image</th>

                        <th>Published At</th>

                        <th>Status</th>

                        <th class="text-center">
                            Actions
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var post in Model.Items)
                    {
                        <tr>

                            <td>
                                @post.Id
                            </td>

                            <td>
                                @post.Title
                            </td>

                            <td style="width: 280px; max-width: 280px;">

                                <div class="text-truncate"
                                     style="max-width: 280px;"
                                     title="@post.Summary">

                                    @post.Summary

                                </div>

                            </td>

                            <td>

                                @if (!string.IsNullOrEmpty(post.ImageUrl))
                                {
                                    <img src="@post.ImageUrl"
                                         alt="@post.Title"
                                         style="width: 80px;
                                                            height: 50px;
                                                            object-fit: cover;" />
                                }
                                else
                                {
                                    <span>No image</span>
                                }

                            </td>

                            <td>
                                @post.PublishedAt.ToString("yyyy/MM/dd")
                            </td>

                            <td>

                                @if (post.IsPublished)
                                {
                                    <span class="badge text-bg-success">
                                        Published
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">
                                        Draft
                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <!-- Edit -->

                                <a asp-area="Admin"
                                   asp-controller="BlogPosts"
                                   asp-action="Edit"
                                   asp-route-id="@post.Id"
                                   class="btn btn-sm btn-link text-primary p-1"
                                   title="Edit">

                                    <i class="bi bi-pencil"></i>

                                </a>


                                <!-- Delete -->

                                <form asp-area="Admin"
                                      asp-controller="BlogPosts"
                                      asp-action="Delete"
                                      asp-route-id="@post.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-link text-danger p-1"
                                            title="Delete"
                                            onclick="return confirm('Are you sure you want to delete this blog post?');">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Blog posts pagination">
                    <ul class="pagination justify-content-center mt-4">

                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-area="Admin"
                               asp-controller="BlogPosts"
                               asp-action="Index"
                               asp-route-page="@(Model.PageNumber - 1)">
                                Previous
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   asp-area="Admin"
                                   asp-controller="BlogPosts"
                                   asp-action="Index"
                                   asp-route-page="@i">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-area="Admin"
                               asp-controller="BlogPosts"
                               asp-action="Index"
                               asp-route-page="@(Model.PageNumber + 1)">
                                Next
                            </a>
                        </li>

                    </ul>
                </nav>
            }
        }

    </div>

</div>