@model ImmigrationWebsite.Web.Models.ConsultationRequest

@{
    ViewData["Title"] = "Consultation Request Details";
}

<div class="row">

    <div class="col-md-10">

        <div class="card card-primary">

            <div class="card-header">

                <h3 class="card-title">
                    Consultation Request Details
                </h3>

            </div>

            <div class="card-body">

                <!-- ID -->

                <div class="row mb-3">

                    <div class="col-md-3">
                        <strong>Request ID</strong>
                    </div>

                    <div class="col-md-9">
                        @Model.Id
                    </div>

                </div>


                <!-- Full Name -->

                <div class="row mb-3">

                    <div class="col-md-3">
                        <strong>Full Name</strong>
                    </div>

                    <div class="col-md-9">
                        @Model.FullName
                    </div>

                </div>


                <!-- Email -->

                <div class="row mb-3">

                    <div class="col-md-3">
                        <strong>Email</strong>
                    </div>

                    <div class="col-md-9">

                        <a href="mailto:@Model.Email">
                            @Model.Email
                        </a>

                    </div>

                </div>


                <!-- Phone -->

                <div class="row mb-3">

                    <div class="col-md-3">
                        <strong>Phone</strong>
                    </div>

                    <div class="col-md-9">

                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <a href="tel:@Model.Phone">
                                @Model.Phone
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">
                                Not provided
                            </span>
                        }

                    </div>

                </div>


                <!-- Country -->

                <div class="row mb-3">

                    <div class="col-md-3">
                        <strong>Country</strong>
                    </div>

                    <div class="col-md-9">

                        @if (!string.IsNullOrEmpty(Model.Country))
                        {
                            @Model.Country
                        }
                        else
                        {
                            <span class="text-muted">
                                Not provided
                            </span>
                        }

                    </div>

                </div>


                <!-- Service -->

                <div class="row mb-3">

                    <div class="col-md-3">
                        <strong>Service</strong>
                    </div>

                    <div class="col-md-9">

                        @if (!string.IsNullOrEmpty(Model.Service))
                        {
                            @Model.Service
                        }
                        else
                        {
                            <span class="text-muted">
                                Not provided
                            </span>
                        }

                    </div>

                </div>


                <!-- Created At -->

                <div class="row mb-3">

                    <div class="col-md-3">
                        <strong>Created At</strong>
                    </div>

                    <div class="col-md-9">
                        @Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                    </div>

                </div>


                <!-- Message -->

                <div class="mb-3">

                    <strong>Message</strong>

                    <div class="border rounded p-3 mt-2"
                         style="min-height:120px;
            white-space:pre-wrap;
            color:#212529;
            background-color:#f8f9fa;">

                        @if (!string.IsNullOrEmpty(Model.Message))
                        {
                            @Model.Message
                        }
                        else
                        {
                            <span class="text-muted">
                                No message provided.
                            </span>
                        }

                    </div>

                </div>

            </div>


            <div class="card-footer">

                <a asp-area="Admin"
                   asp-controller="ConsultationRequests"
                   asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left"></i>
                    Back to Requests

                </a>

                <a asp-area="Admin"
                   asp-controller="ConsultationRequests"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary ms-2">

                    <i class="bi bi-pencil"></i>
                    Update Status

                </a>

                <form asp-area="Admin"
                      asp-controller="ConsultationRequests"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger ms-2"
                            onclick="return confirm('Are you sure you want to delete this consultation request?');">

                        <i class="bi bi-trash"></i>
                        Delete Request

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>