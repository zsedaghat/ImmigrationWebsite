@model ImmigrationWebsite.Web.Models.Pagination.PagedResult<ImmigrationWebsite.Web.Models.ConsultationRequest>

@{
    ViewData["Title"] = "Consultation Requests";
}

<div class="card">

    <div class="card-header">

        <div class="d-flex justify-content-between align-items-center w-100">

            <h3 class="card-title mb-0">
                Consultation Requests
            </h3>

            <span class="badge text-bg-primary">
                @Model.TotalItems Requests
            </span>

        </div>

    </div>

    <div class="card-body">

        @if (!Model.Items.Any())
        {
            <p>No consultation requests found.</p>
        }
        else
        {
            <table class="table table-bordered table-striped">

                <thead>
                    <tr>

                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Country</th>
                        <th>Service</th>
                        <th>Status</th>
                        <th>Created At</th>

                        <th class="text-center">
                            Actions
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var request in Model.Items)
                    {
                        <tr>

                            <td>
                                @request.Id
                            </td>

                            <td>
                                @request.FullName
                            </td>

                            <td>
                                @request.Email
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(request.Phone))
                                {
                                    @request.Phone
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(request.Country))
                                {
                                    @request.Country
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(request.Service))
                                {
                                    @request.Service
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }
                            </td>

                            <td>
                                @if (request.Status == "New")
                                {
                                    <span class="badge text-bg-warning">
                                        New
                                    </span>
                                }
                                else if (request.Status == "Contacted")
                                {
                                    <span class="badge text-bg-primary">
                                        Contacted
                                    </span>
                                }
                                else if (request.Status == "Completed")
                                {
                                    <span class="badge text-bg-success">
                                        Completed
                                    </span>
                                }
                                else if (request.Status == "Cancelled")
                                {
                                    <span class="badge text-bg-danger">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">
                                        @request.Status
                                    </span>
                                }
                            </td>

                            <td>
                                @request.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                            </td>

                            <td class="text-center">

                                <a asp-area="Admin"
                                   asp-controller="ConsultationRequests"
                                   asp-action="Details"
                                   asp-route-id="@request.Id"
                                   class="btn btn-sm btn-link text-primary p-1"
                                   title="View Details">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <form asp-area="Admin"
                                      asp-controller="ConsultationRequests"
                                      asp-action="Delete"
                                      asp-route-id="@request.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-link text-danger p-1"
                                            title="Delete"
                                            onclick="return confirm('Are you sure you want to delete this consultation request?');">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Consultation requests pagination">

                    <ul class="pagination justify-content-center mt-4">

                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">

                            <a class="page-link"
                               asp-area="Admin"
                               asp-controller="ConsultationRequests"
                               asp-action="Index"
                               asp-route-page="@(Model.PageNumber - 1)">

                                Previous

                            </a>

                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">

                                <a class="page-link"
                                   asp-area="Admin"
                                   asp-controller="ConsultationRequests"
                                   asp-action="Index"
                                   asp-route-page="@i">

                                    @i

                                </a>

                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">

                            <a class="page-link"
                               asp-area="Admin"
                               asp-controller="ConsultationRequests"
                               asp-action="Index"
                               asp-route-page="@(Model.PageNumber + 1)">

                                Next

                            </a>

                        </li>

                    </ul>

                </nav>
            }

        }

    </div>

</div>