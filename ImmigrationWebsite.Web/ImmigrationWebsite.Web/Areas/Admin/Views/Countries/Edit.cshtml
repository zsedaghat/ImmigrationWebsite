@model ImmigrationWebsite.Web.Models.Country

@{
    ViewData["Title"] = "Edit Country";
}

<div class="row">

    <div class="col-md-8">

        <div class="card card-primary">

            <div class="card-header">
                <h3 class="card-title">
                    Edit Country
                </h3>
            </div>

            <form asp-area="Admin"
                  asp-controller="Countries"
                  asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div class="card-body">

                    <!-- Country Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">
                            Country Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter country name" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>


                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Enter country description"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>


                    <!-- Current Country Image -->
                    <div class="mb-3">

                        <label class="form-label">
                            Current Country Image
                        </label>

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.ImageUrl"
                                     alt="@Model.Name"
                                     style="
                                            width:180px;
                                            height:120px;
                                            object-fit:cover;
                                            border-radius:8px;
                                            border:1px solid #dee2e6;" />
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">
                                No country image uploaded.
                            </p>
                        }

                    </div>


                    <!-- Change Country Image -->
                    <div class="mb-3">

                        <label for="Image" class="form-label">
                            Change Country Image
                        </label>

                        <input type="file"
                               id="Image"
                               name="Image"
                               class="form-control"
                               accept="image/*" />

                        <div class="form-text">
                            Leave empty to keep the current image.
                        </div>

                        <div class="mt-3">

                            <img id="imagePreview"
                                 src="#"
                                 alt="New Country Image Preview"
                                 style="
                                    display:none;
                                    width:180px;
                                    height:120px;
                                    object-fit:cover;
                                    border-radius:8px;
                                    border:1px solid #dee2e6;" />

                        </div>

                    </div>


                    <!-- Current Flag -->
                    <div class="mb-3">

                        <label class="form-label">
                            Current Country Flag
                        </label>

                        @if (!string.IsNullOrEmpty(Model.FlagImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.FlagImageUrl"
                                     alt="@Model.Name Flag"
                                     style="
                                            width:80px;
                                            height:80px;
                                            object-fit:cover;
                                            border-radius:50%;
                                            border:1px solid #dee2e6;" />
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">
                                No flag uploaded.
                            </p>
                        }

                    </div>


                    <!-- Change Flag -->
                    <div class="mb-3">

                        <label for="FlagImage" class="form-label">
                            Change Country Flag
                        </label>

                        <input type="file"
                               id="FlagImage"
                               name="FlagImage"
                               class="form-control"
                               accept="image/*" />

                        <div class="form-text">
                            Leave empty to keep the current flag.
                        </div>

                        <div class="mt-3">

                            <img id="flagPreview"
                                 src="#"
                                 alt="New Flag Preview"
                                 style="
                                    display:none;
                                    width:80px;
                                    height:80px;
                                    object-fit:cover;
                                    border-radius:50%;
                                    border:1px solid #dee2e6;" />

                        </div>

                    </div>


                    <!-- Display Order -->
                    <div class="mb-3">

                        <label asp-for="DisplayOrder"
                               class="form-label">
                            Display Order
                        </label>

                        <input asp-for="DisplayOrder"
                               type="number"
                               class="form-control"
                               min="1" />

                        <span asp-validation-for="DisplayOrder"
                              class="text-danger"></span>

                    </div>


                    <!-- Status -->
                    <div class="mb-3">

                        <label class="form-label d-block">
                            Country Status
                        </label>

                        <div class="form-check form-switch">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="IsActive" />

                            <label class="form-check-label"
                                   for="IsActive">
                                Active Country
                            </label>

                        </div>

                    </div>

                </div>


                <!-- Footer -->
                <div class="card-footer">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>
                        Save Changes

                    </button>

                    <a asp-area="Admin"
                       asp-controller="Countries"
                       asp-action="Index"
                       class="btn btn-secondary ms-2">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // Country Image Preview
        document.getElementById('Image').addEventListener('change', function (event) {

            const file = event.target.files[0];
            const preview = document.getElementById('imagePreview');

            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.style.display = 'block';
            }
            else {
                preview.src = '#';
                preview.style.display = 'none';
            }

        });


        // Flag Preview
        document.getElementById('FlagImage').addEventListener('change', function (event) {

            const file = event.target.files[0];
            const preview = document.getElementById('flagPreview');

            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.style.display = 'block';
            }
            else {
                preview.src = '#';
                preview.style.display = 'none';
            }

        });

    </script>
}