@model ImmigrationWebsite.Web.Areas.Admin.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- Page Header -->

    <div class="mb-4">

        <h1 class="h3 mb-1">
            Dashboard
        </h1>

        <p class="text-muted mb-0">
            Welcome to Immigration Website Admin Panel
        </p>

    </div>


    <!-- Statistics -->

    <div class="row">


        <!-- Countries -->

        <div class="col-lg-3 col-md-6 col-12">

            <div class="small-box text-bg-primary">

                <div class="inner">

                    <h3>
                        @Model.CountriesCount
                    </h3>

                    <p>
                        Countries
                    </p>

                </div>

                <div class="icon">
                    <i class="bi bi-globe"></i>
                </div>

                <a asp-area="Admin"
                   asp-controller="Countries"
                   asp-action="Index"
                   class="small-box-footer">

                    Manage Countries
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>


        <!-- Services -->

        <div class="col-lg-3 col-md-6 col-12">

            <div class="small-box text-bg-success">

                <div class="inner">

                    <h3>
                        @Model.ServicesCount
                    </h3>

                    <p>
                        Services
                    </p>

                </div>

                <div class="icon">
                    <i class="bi bi-briefcase"></i>
                </div>

                <a asp-area="Admin"
                   asp-controller="Services"
                   asp-action="Index"
                   class="small-box-footer">

                    Manage Services
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>


        <!-- Blog Posts -->

        <div class="col-lg-3 col-md-6 col-12">

            <div class="small-box text-bg-warning">

                <div class="inner">

                    <h3>
                        @Model.BlogPostsCount
                    </h3>

                    <p>
                        Blog Posts
                    </p>

                </div>

                <div class="icon">
                    <i class="bi bi-file-text"></i>
                </div>

                <a asp-area="Admin"
                   asp-controller="BlogPosts"
                   asp-action="Index"
                   class="small-box-footer">

                    Manage Blog Posts
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>


        <!-- Consultation Requests -->

        <div class="col-lg-3 col-md-6 col-12">

            <div class="small-box text-bg-danger">

                <div class="inner">

                    <h3>
                        @Model.ConsultationRequestsCount
                    </h3>

                    <p>
                        Consultation Requests
                    </p>

                </div>

                <div class="icon">
                    <i class="bi bi-chat-dots"></i>
                </div>

                <a asp-area="Admin"
                   asp-controller="ConsultationRequests"
                   asp-action="Index"
                   class="small-box-footer">

                    View Requests
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>


        <!--  New Requests -->
       
        <div class="col-lg-3 col-md-6 col-12">

            <div class="small-box text-bg-info">

                <div class="inner">

                    <h3>
                        @Model.NewConsultationRequestsCount
                    </h3>

                    <p>
                        New Requests
                    </p>

                </div>

                <div class="icon">
                    <i class="bi bi-bell"></i>
                </div>

                <a asp-area="Admin"
                   asp-controller="ConsultationRequests"
                   asp-action="Index"
                   class="small-box-footer">

                    View Requests
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>


    <!-- Latest Consultation Requests -->

    <div class="row">

        <div class="col-12">

            <div class="card">

                <div class="card-header">

                    <h3 class="card-title">
                        Latest Consultation Requests
                    </h3>

                    <div class="card-tools">

                        <a asp-area="Admin"
                           asp-controller="ConsultationRequests"
                           asp-action="Index"
                           class="btn btn-sm btn-primary">

                            View All

                        </a>

                    </div>

                </div>


                <div class="card-body p-0">

                    @if (!Model.LatestConsultationRequests.Any())
                    {
                        <div class="p-4 text-center text-muted">

                            <i class="bi bi-inbox fs-2"></i>

                            <p class="mt-2 mb-0">
                                No consultation requests found.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover mb-0">

                                <thead>

                                    <tr>

                                        <th>ID</th>

                                        <th>Full Name</th>

                                        <th>Email</th>

                                        <th>Country</th>

                                        <th>Service</th>

                                        <th>Status</th>

                                        <th>Created At</th>

                                        <th class="text-center">
                                            Action
                                        </th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var request in Model.LatestConsultationRequests)
                                    {
                                        <tr>

                                            <td>
                                                @request.Id
                                            </td>

                                            <td>
                                                @request.FullName
                                            </td>

                                            <td>
                                                @request.Email
                                            </td>

                                            <td>
                                                @(string.IsNullOrEmpty(request.Country)
                                                                                        ? "-"
                                                                                        : request.Country)
                                                                                                      </td>

                                            <td>
                                                @(string.IsNullOrEmpty(request.Service)
                                                                                        ? "-"
                                                                                        : request.Service)
                                    </td>

                                            <td>
                                        @if (request.Status == "New")
                                                {
                                                    <span class="badge text-bg-warning">New</span>
                                                }
                                                else if (request.Status == "Contacted")
                                                {
                                                    <span class="badge text-bg-primary">Contacted</span>
                                                }
                                                else if (request.Status == "Completed")
                                                {
                                                    <span class="badge text-bg-success">Completed</span>
                                                }
                                                else if (request.Status == "Cancelled")
                                                {
                                                    <span class="badge text-bg-danger">Cancelled</span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-secondary">
                                                        @request.Status
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @request.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                            </td>

                                         @*    <td>
                                                @request.CreatedAt
                                                .ToLocalTime()
                                                .ToString("yyyy/MM/dd HH:mm")
                                            </td> *@

                                            <td class="text-center">

                                                <a asp-area="Admin"
                                                   asp-controller="ConsultationRequests"
                                                   asp-action="Details"
                                                   asp-route-id="@request.Id"
                                                   class="btn btn-sm btn-link text-primary"
                                                   title="View Details">

                                                    <i class="bi bi-eye"></i>

                                                </a>

                                            </td>

                                        </tr>
                                                                }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>