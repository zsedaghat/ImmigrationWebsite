@model List<ImmigrationWebsite.Web.Models.Service>

<div class="footer-item d-flex flex-column">

    <h4 class="text-secondary mb-4">
        SERVICES
    </h4>

    @{
        var excludedSlugs = new[]
        {
            "canada",
            "travel-visas",
            "education",
            "resources"
        };
    }

    @foreach (var service in Model.Where(x =>
        x.Slug == null || !excludedSlugs.Contains(x.Slug)))
    {
        <a href="/services/@service.Id">
            <i class="fas fa-angle-right me-2"></i>
            @service.Title
        </a>
    }

    <a asp-controller="Services"
       asp-action="Index"
       class="mt-2">

        <i class="fas fa-angle-right me-2"></i>
        View All Services

    </a>

</div>