<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @{
        var pageTitle = ViewData["Title"]?.ToString();

        var fullTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "Global Bridge Support Services | Canada & International Support"
        : $"{pageTitle} | Global Bridge Support Services";

        var currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    }

    <!-- SEO Title -->
    <title>@fullTitle</title>

    <!-- SEO Description -->
    <meta name="description"
          content="Practical administrative support for applications, Canada settlement, education, employment, housing, documents, benefits and international travel visa applications." />

    <!-- Canonical URL -->
    <link rel="canonical"
          href="@currentUrl" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:site_name"
          content="Global Bridge Support Services" />

    <meta property="og:title"
          content="@fullTitle" />

    <meta property="og:description"
          content="Practical administrative support for applications, Canada settlement, education, employment, housing, documents, benefits and international travel visa applications." />

    <meta property="og:type"
          content="website" />

    <meta property="og:url"
          content="@currentUrl" />

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Poppins:wght@200;300;400;500;600&display=swap"
          rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet"
          href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css"
          rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/lib/animate/animate.min.css"
          rel="stylesheet">

    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css"
          rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/css/style.css"
          rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <!-- Topbar Start -->
    <div class="container-fluid bg-primary px-5 d-none d-lg-block">
        <div class="row gx-0 align-items-center">

            <div class="col-lg-5 text-center text-lg-start mb-lg-0">

                <div class="d-flex">

                    <a href="mailto:info@globalbridgesupport.com"
                       class="text-muted me-4">

                        <i class="fas fa-envelope text-secondary me-2"></i>
                        info@globalbridgesupport.com

                    </a>

                    @*
                    <a href="#"
                       class="text-muted me-0">

                        <i class="fas fa-phone-alt text-secondary me-2"></i>
                        +01234567890

                    </a>
                    *@

                </div>

            </div>


            <div class="col-lg-4 text-center text-lg-end">

                <div class="d-inline-flex align-items-center"
                     style="height: 45px;">

                    <a asp-controller="Blog"
                       asp-action="Index"
                       class="text-muted me-2">

                        Resources

                    </a>

                    <small> / </small>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="text-muted mx-2">

                        Support

                    </a>

                    <small> / </small>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="text-muted ms-2">

                        Contact

                    </a>

                </div>

            </div>

        </div>
    </div>
    <!-- Topbar End -->
    <!-- Navbar Start -->
    <div class="container-fluid nav-bar p-0">

        <nav class="navbar navbar-expand-xl navbar-light bg-white px-3 py-3">

            <!-- Logo -->
            <a href="/"
               class="navbar-brand p-0 d-flex align-items-center flex-shrink-0">

                <img src="~/img/brand-logo.png"
                     class="img-fluid me-2"
                     alt="Global Bridge Support Services"
                     style="height: 48px; width: auto;">

                <div class="d-flex flex-column"
                     style="line-height: 1.05; white-space: nowrap;">

                    <span class="text-secondary fw-bold"
                          style="font-size: 20px;">

                        GLOBAL BRIDGE

                    </span>

                    <span class="text-secondary"
                          style="font-size: 11px; letter-spacing: 2px;">

                        SUPPORT SERVICES

                    </span>

                </div>

            </a>


            <!-- Mobile Button -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarCollapse">

                <span class="fa fa-bars"></span>

            </button>


            <!-- Menu -->
            <div class="collapse navbar-collapse"
                 id="navbarCollapse">

                <div class="navbar-nav py-0 flex-nowrap global-menu">

                    <!-- HOME -->
                    <a href="/"
                       class="nav-item nav-link active px-2">

                        HOME

                    </a>


                    <!-- ABOUT -->
                    <a asp-controller="Home"
                       asp-action="About"
                       class="nav-item nav-link px-2">

                        ABOUT US

                    </a>


                    <!-- SERVICES -->
                    <div class="nav-item dropdown">

                        <a href="#"
                           class="nav-link px-2"
                           data-bs-toggle="dropdown">

                            <span class="dropdown-toggle">
                                SERVICES
                            </span>

                        </a>

                        <div class="dropdown-menu m-0">

                            @await Component.InvokeAsync("ServicesMenu")

                        </div>

                    </div>


                    <!-- CANADA -->
                    <a href="/services/canada"
                       class="nav-item nav-link px-2">

                        CANADA

                    </a>


                    <!-- TRAVEL VISAS -->
                    <a href="/services/travel-visas"
                       class="nav-item nav-link px-2">

                        TRAVEL VISAS

                    </a>


                    <!-- EDUCATION -->
                    <a href="/services/education"
                       class="nav-item nav-link px-2">

                        EDUCATION

                    </a>


                    <!-- RESOURCES -->

                    <a asp-controller="Blog"
                       asp-action="Index"
                       class="nav-item nav-link px-2">

                        RESOURCES
               
                    </a>


                    <!-- CONTACT -->
                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="nav-item nav-link px-2">

                        CONTACT US

                    </a>

                </div>


                <!-- Get Support -->
                <a asp-controller="Home"
                   asp-action="Contact"
                   class="btn btn-primary border-secondary rounded-pill py-2 px-3 ms-3 flex-shrink-0">

                    GET SUPPORT

                </a>

            </div>

        </nav>

    </div>
    <!-- Navbar End -->
    <!-- Main Content -->
    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- Footer Start -->
    <footer class="container-fluid footer py-5 wow fadeIn"
            data-wow-delay="0.2s">

        <div class="container py-5">

            <div class="row g-5">


                <!-- GLOBAL BRIDGE -->
                <div class="col-md-6 col-lg-6 col-xl-3">

                    <div class="footer-item d-flex flex-column">

                        <h4 class="text-secondary mb-4">
                            GLOBAL BRIDGE
                        </h4>

                        <p class="text-white mb-0">

                            Practical administrative and support services for individuals,
                            newcomers, students, families and businesses in Canada and internationally.

                        </p>

                    </div>

                </div>


                <!-- SERVICES -->
                <div class="col-md-6 col-lg-6 col-xl-3">

                    <div class="footer-item d-flex flex-column">

                        @await Component.InvokeAsync("ServicesFooter")

                    </div>

                </div>


                <!-- QUICK LINKS -->
                <div class="col-md-6 col-lg-6 col-xl-3">

                    <div class="footer-item d-flex flex-column">

                        <h4 class="text-secondary mb-4">
                            QUICK LINKS
                        </h4>


                        <!-- About -->
                        <a asp-controller="Home"
                           asp-action="About">

                            <i class="fas fa-angle-right me-2"></i>
                            About

                        </a>


                        <!-- Resources -->
                        <a asp-controller="Blog"
                           asp-action="Index">

                            <i class="fas fa-angle-right me-2"></i>
                            Resources

                        </a>


                        <!-- Contact -->
                        <a asp-controller="Home"
                           asp-action="Contact">

                            <i class="fas fa-angle-right me-2"></i>
                            Contact

                        </a>


                        <!-- Privacy Policy -->
                        <a asp-controller="Home"
                           asp-action="PrivacyPolicy">

                            <i class="fas fa-angle-right me-2"></i>
                            Privacy Policy

                        </a>


                        <!-- Disclaimer -->
                        <a asp-controller="Home"
                           asp-action="Disclaimer">

                            <i class="fas fa-angle-right me-2"></i>
                            Terms &amp; Disclaimer

                        </a>

                    </div>

                </div>


                <!-- CONTACT -->
                <div class="col-md-6 col-lg-6 col-xl-3">

                    <div class="footer-item d-flex flex-column">

                        <h4 class="text-secondary mb-4">
                            CONTACT
                        </h4>


                        <!-- Email -->
                        <a href="mailto:info@globalbridgesupport.com">

                            <i class="fas fa-envelope me-2"></i>
                            Email

                        </a>


                        <!-- Instagram -->
                        <a href="https://www.instagram.com/globalbridge_sup/"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Instagram">
                            <i class="fab fa-instagram"> </i>
                            Instagram
                        </a>

                    </div>

                </div>


            </div>

        </div>

    </footer>
    <!-- Footer End -->
    <!-- JavaScript Libraries -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/wow/wow.min.js"></script>

    <script src="~/lib/easing/easing.min.js"></script>

    <script src="~/lib/waypoints/waypoints.min.js"></script>

    <script src="~/lib/counterup/counterup.min.js"></script>

    <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>


    <!-- Template Javascript -->
    <script src="~/js/main.js"></script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>