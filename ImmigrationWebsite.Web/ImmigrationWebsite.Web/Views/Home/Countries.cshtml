@model List<ImmigrationWebsite.Web.Models.Country>

@{
    ViewData["Title"] = "Countries";
}

<!-- Countries Start -->
<div class="container-fluid country overflow-hidden py-5">
    <div class="container py-5">

        <div class="text-center mx-auto pb-5 wow fadeInUp"
             data-wow-delay="0.1s"
             style="max-width: 800px;">

            <h1 class="display-5 text-capitalize mb-3">
                Immigration <span class="text-primary">Countries</span>
            </h1>

            <p class="mb-0">
                Explore immigration opportunities and services available in different countries.
            </p>
        </div>

        <div class="row g-4">

            @foreach (var country in Model)
            {
                <div class="col-lg-4 col-md-6 wow fadeInUp">
                    <div class="country-item">

                        <div class="country-img">
                            @if (!string.IsNullOrEmpty(country.ImageUrl))
                            {
                                <img src="@country.ImageUrl"
                                     class="img-fluid w-100 rounded"
                                     alt="@country.Name">
                            }
                            else
                            {
                                <img src="~/img/country-1.jpg"
                                     class="img-fluid w-100 rounded"
                                     alt="@country.Name">
                            }
                        </div>

                        <div class="country-content p-4">
                            <h4 class="mb-3">@country.Name</h4>

                            <p class="mb-3">
                                @country.Description
                            </p>

                            <a href="#"
                               class="btn btn-primary rounded-pill py-2 px-4">
                                Read More
                            </a>
                        </div>

                    </div>
                </div>
            }

        </div>
    </div>
</div>
<!-- Countries End -->