@{
    ViewData["Title"] = "Privacy Policy";
}

<!-- Header -->
<div class="container-fluid bg-primary py-5">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">

                <h1 class="display-4 text-white mb-3">
                    Privacy Policy
                </h1>

                <p class="text-white mb-0">
                    Your privacy and the responsible handling of your information are important to us.
                </p>

            </div>
        </div>
    </div>
</div>

<!-- Privacy Policy Content -->
<div class="container-fluid py-5">
    <div class="container py-5">

        <div class="row justify-content-center">
            <div class="col-lg-9">

                <div class="bg-light rounded p-5">

                    <h2 class="mb-4">
                        Privacy Policy
                    </h2>

                    <p>
                        Global Bridge Support Services respects your privacy and is committed
                        to protecting the personal information you provide when using our
                        website and services.
                    </p>

                    <p>
                        This Privacy Policy explains how information may be collected,
                        used and protected when you contact us, request support, submit
                        information through our website or otherwise communicate with
                        Global Bridge Support Services.
                    </p>

                    <hr class="my-4" />

                    <h4 class="mb-3">
                        Information We May Collect
                    </h4>

                    <p>
                        Depending on the service you request, we may collect information
                        such as:
                    </p>

                    <ul>
                        <li>Your name and contact information</li>
                        <li>Email address and phone number</li>
                        <li>Information you provide through consultation or contact forms</li>
                        <li>Documents or information voluntarily provided for support services</li>
                        <li>Information related to the service you are requesting</li>
                        <li>Other information you voluntarily provide to us</li>
                    </ul>

                    <p>
                        You should only provide information that is relevant to the service
                        you are requesting.
                    </p>

                    <hr class="my-4" />

                    <h4 class="mb-3">
                        How We Use Your Information
                    </h4>

                    <p>
                        Information provided to Global Bridge Support Services may be used
                        to:
                    </p>

                    <ul>
                        <li>Respond to your inquiries and requests</li>
                        <li>Provide administrative and support services</li>
                        <li>Communicate with you regarding requested services</li>
                        <li>Prepare or organize information and documents based on your instructions</li>
                        <li>Improve our website, services and user experience</li>
                        <li>Maintain records related to our communications and services</li>
                    </ul>

                    <p>
                        We do not use your information for purposes unrelated to the services
                        or communications you have requested, except where required or
                        permitted by applicable law.
                    </p>

                    <hr class="my-4" />

                    <h4 class="mb-3">
                        Information Sharing
                    </h4>

                    <p>
                        We do not sell or rent your personal information.
                    </p>

                    <p>
                        Information may be shared when necessary to provide a requested
                        service, when you specifically authorize us to do so, or when
                        disclosure is required or permitted by applicable law.
                    </p>

                    <p>
                        Where regulated professional advice or representation is required,
                        you may be referred to an appropriately authorized professional.
                    </p>

                    <hr class="my-4" />

                    <h4 class="mb-3">
                        Information Security
                    </h4>

                    <p>
                        We take reasonable measures to protect personal information against
                        unauthorized access, use, disclosure, alteration or loss.
                    </p>

                    <p>
                        However, no website, electronic communication or method of storing
                        information can be guaranteed to be completely secure. You should
                        avoid sending unnecessary sensitive information through ordinary
                        website forms or email.
                    </p>

                    <hr class="my-4" />

                    <h4 class="mb-3">
                        Third-Party Websites
                    </h4>

                    <p>
                        Our website may contain links to third-party websites, platforms
                        or services. These websites operate independently and may have
                        their own privacy policies and practices.
                    </p>

                    <p>
                        Global Bridge Support Services is not responsible for the privacy
                        practices or content of third-party websites.
                    </p>

                    <hr class="my-4" />

                    <h4 class="mb-3">
                        Cookies and Website Information
                    </h4>

                    <p>
                        Our website may use cookies or similar technologies to support
                        website functionality, security and user experience.
                    </p>

                    <p>
                        We may also collect limited technical information, such as browser
                        type, device information or general website usage information,
                        where necessary for website operation, security or improvement.
                    </p>

                    <hr class="my-4" />

                    <h4 class="mb-3">
                        Your Responsibility
                    </h4>

                    <p>
                        You are responsible for ensuring that the information you provide
                        to us is accurate, complete and up to date.
                    </p>

                    <p>
                        You should not provide personal information belonging to another
                        person unless you are authorized to provide it.
                    </p>

                    <hr class="my-4" />

                    <h4 class="mb-3">
                        Changes to This Privacy Policy
                    </h4>

                    <p>
                        Global Bridge Support Services may update this Privacy Policy from
                        time to time to reflect changes in our services, website practices
                        or applicable requirements.
                    </p>

                    <p>
                        Any updated version may be posted on this page with a revised
                        effective date.
                    </p>

                    <hr class="my-4" />

                    <h4 class="mb-3">
                        Contact Us
                    </h4>

                    <p>
                        If you have questions about this Privacy Policy or how your
                        information is handled, please contact us:
                    </p>

                    <p class="mb-0">
                        <strong>Email:</strong>
                        <a href="mailto:info@globalbridgesupport.com">
                            info@globalbridgesupport.com
                        </a>
                    </p>

                </div>

            </div>
        </div>

    </div>
</div>