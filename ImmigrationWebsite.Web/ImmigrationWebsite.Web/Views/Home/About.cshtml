@{
    ViewData["Title"] = "About Us";
}

<!-- Page Header Start -->
<div class="container-fluid page-header py-5"
     style="background: linear-gradient(rgba(11, 27, 51, .78), rgba(20, 41, 75, .78)), url('/img/aboutUs.jpeg') center center / cover no-repeat;">

    <div class="container py-5">

        <h1 class="display-3 text-white mb-3 internal-page-title">
            About Us
        </h1>

        <p class="text-white mb-0 internal-page-subtitle">
            Practical support for your next step.
        </p>

    </div>

</div>
<!-- Page Header End -->
<!-- About Start -->
<div class="container-fluid py-5 about-page">

    <div class="container py-5">

        <div class="row g-5 align-items-center">

            <!-- Image -->
            <div class="col-lg-6 wow fadeInLeft"
                 data-wow-delay="0.1s">

                <div class="about-image-wrapper">

                    <img src="~/img/parisa.png"
                         class="img-fluid"
                         alt="Global Bridge Support Services">

                </div>

            </div>


            <!-- Content -->
            <div class="col-lg-6 wow fadeInRight"
                 data-wow-delay="0.2s">

                <div class="section-title mb-4">

                    <div class="sub-style">

                        <h5 class="sub-title px-3">
                            ABOUT US
                        </h5>

                    </div>

                    <h1 class="display-5 mb-4">
                        Practical Support for Your Next Step
                    </h1>

                </div>


                <div class="about-content">

                    <p class="mb-4">
                        Global Bridge Support Services provides practical
                        administrative and support services for individuals,
                        newcomers, students, families and businesses in Canada
                        and internationally.
                    </p>

                    <p class="mb-4">
                        We help make everyday processes easier to understand
                        and manage by providing clear information, practical
                        assistance and personalized support based on your needs.
                    </p>


                    <!-- Features -->
                    <div class="row gy-3 mb-4">

                        <!-- Professional Support -->
                        <div class="col-sm-6">

                            <div class="about-feature">

                                <div class="feature-icon">

                                    <i class="fa fa-check"></i>

                                </div>

                                <div>

                                    <h5>
                                        Professional Support
                                    </h5>

                                    <p>
                                        Clear and practical assistance for your needs.
                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- Personalized Service -->
                        <div class="col-sm-6">

                            <div class="about-feature">

                                <div class="feature-icon">

                                    <i class="fa fa-user-check"></i>

                                </div>

                                <div>

                                    <h5>
                                        Personalized Service
                                    </h5>

                                    <p>
                                        Support based on your individual situation.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Button -->
                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="btn btn-primary rounded-pill py-3 px-5">

                        Get Support

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- About End -->
<!-- Why Choose Us Start -->
<div class="container-fluid py-5 why-section about-page">

    <div class="container py-5">

        <div class="section-title text-center mb-5 wow fadeInUp"
             data-wow-delay="0.1s">

            <div class="sub-style">

                <h5 class="sub-title px-3">
                    WHY CHOOSE US
                </h5>

            </div>

            <h1 class="display-5 mb-4">
                Support You Can Rely On
            </h1>

            <p class="mb-0">
                We focus on making complicated processes easier to
                understand and everyday tasks easier to manage.
            </p>

        </div>


        <div class="row g-4">

            <!-- Professional Support -->
            <div class="col-md-6 col-lg-4 wow fadeInUp"
                 data-wow-delay="0.1s">

                <div class="why-card text-center">

                    <div class="why-icon">

                        <i class="fa fa-user-tie"></i>

                    </div>

                    <h4 class="mb-3">
                        Professional Support
                    </h4>

                    <p class="mb-0">
                        We provide practical assistance designed to help
                        you understand your options and move forward with
                        greater confidence.
                    </p>

                </div>

            </div>


            <!-- Personalized Approach -->
            <div class="col-md-6 col-lg-4 wow fadeInUp"
                 data-wow-delay="0.3s">

                <div class="why-card text-center">

                    <div class="why-icon">

                        <i class="fa fa-users"></i>

                    </div>

                    <h4 class="mb-3">
                        Personalized Approach
                    </h4>

                    <p class="mb-0">
                        Every person and situation is different, so our
                        support is tailored to your individual needs and goals.
                    </p>

                </div>

            </div>


            <!-- Dedicated Support -->
            <div class="col-md-6 col-lg-4 wow fadeInUp"
                 data-wow-delay="0.5s">

                <div class="why-card text-center">

                    <div class="why-icon">

                        <i class="fa fa-headset"></i>

                    </div>

                    <h4 class="mb-3">
                        Dedicated Support
                    </h4>

                    <p class="mb-0">
                        We're here to answer your questions, help you
                        understand the process and support you along the way.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Why Choose Us End -->
<!-- Mission Start -->
<div class="container-fluid py-5 about-page">

    <div class="container py-5">

        <div class="row g-5 align-items-center">

            <!-- Mission Content -->
            <div class="col-lg-6 wow fadeInLeft"
                 data-wow-delay="0.1s">

                <div class="section-title mb-4">

                    <div class="sub-style">

                        <h5 class="sub-title px-3">
                            OUR MISSION
                        </h5>

                    </div>

                    <h1 class="display-5 mb-4">
                        Making Everyday Processes Simpler
                    </h1>

                </div>

                <div class="mission-content">

                    <p class="mb-4">
                        Our mission is to make complicated processes easier
                        to understand and everyday tasks simpler to manage.
                    </p>

                    <p class="mb-0">
                        Whether you are settling into a new environment,
                        pursuing education, looking for employment, managing
                        documents or handling everyday administrative needs,
                        we aim to provide practical support at every step.
                    </p>

                </div>

            </div>


            <!-- Mission CTA -->
            <div class="col-lg-6 wow fadeInRight"
                 data-wow-delay="0.3s">

                <div class="mission-box">

                    <h3 class="mb-4">
                        We're Here to Help
                    </h3>

                    <p class="mb-4">
                        Have a question or need support with a specific
                        service? Get in touch with our team and tell us
                        what you need.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="btn btn-primary rounded-pill py-3 px-5">

                        Contact Us

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Mission End -->