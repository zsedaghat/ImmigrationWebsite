@{
    ViewData["Title"] = "About Us";
}

<!-- Page Header Start -->
<div class="container-fluid page-header py-5"
     style="background: linear-gradient(rgba(0, 0, 0, .55), rgba(0, 0, 0, .55)), url('/img/office-3.jpg') center center / cover no-repeat;">

    <div class="container py-5">

        <h1 class="display-3 text-white mb-3 internal-page-title">
            About Us
        </h1>

        <p class="text-white mb-0 internal-page-subtitle">
            Your trusted partner for a successful immigration journey.
        </p>

    </div>

</div>
<!-- Page Header End -->
<!-- About Start -->
<div class="container-fluid py-5">

    <div class="container py-5">

        <div class="row g-5 align-items-center">

            <!-- Image -->
            <div class="col-lg-6 wow fadeInLeft"
                 data-wow-delay="0.1s">

                <div class="position-relative">

                    <img src="~/img/office-3.jpg"
                         class="img-fluid rounded w-100"
                         alt="About Us">

                </div>

            </div>


            <!-- Content -->
            <div class="col-lg-6 wow fadeInRight"
                 data-wow-delay="0.2s">

                <div class="section-title mb-4">

                    <div class="sub-style">
                        <h5 class="sub-title text-primary px-3">
                            ABOUT US
                        </h5>
                    </div>

                    <h1 class="display-5 mb-4">
                        Helping You Build Your Future Abroad
                    </h1>

                </div>

                <p class="mb-4">
                    We provide professional immigration and visa services
                    designed to make your journey simpler, clearer and more
                    successful.
                </p>

                <p class="mb-4">
                    Our team helps individuals and families explore immigration
                    opportunities, understand their options and prepare for
                    the application process with confidence.
                </p>


                <!-- Features -->
                <div class="row gy-4 align-items-center mb-4">

                    <div class="col-sm-6">

                        <div class="d-flex align-items-center">

                            <div class="flex-shrink-0 btn-lg-square bg-primary rounded-circle me-3">

                                <i class="fa fa-check text-white"></i>

                            </div>

                            <div>

                                <h5 class="mb-1">
                                    Professional Guidance
                                </h5>

                                <p class="mb-0">
                                    Clear and reliable immigration support.
                                </p>

                            </div>

                        </div>

                    </div>


                    <div class="col-sm-6">

                        <div class="d-flex align-items-center">

                            <div class="flex-shrink-0 btn-lg-square bg-primary rounded-circle me-3">

                                <i class="fa fa-check text-white"></i>

                            </div>

                            <div>

                                <h5 class="mb-1">
                                    Personalized Service
                                </h5>

                                <p class="mb-0">
                                    Solutions based on your individual goals.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Button -->
                <a asp-controller="Home"
                   asp-action="Contact"
                   class="btn btn-primary border-secondary rounded-pill py-3 px-5">

                    Request a Consultation

                </a>

            </div>

        </div>

    </div>

</div>
<!-- About End -->
<!-- Why Choose Us Start -->
<div class="container-fluid bg-light py-5">

    <div class="container py-5">

        <div class="section-title text-center mb-5 wow fadeInUp"
             data-wow-delay="0.1s">

            <div class="sub-style">

                <h5 class="sub-title text-primary px-3">
                    WHY CHOOSE US
                </h5>

            </div>

            <h1 class="display-5 mb-4">
                Why Choose Our Immigration Services?
            </h1>

            <p class="mb-0">
                We are committed to providing clear, professional and
                personalized support throughout your immigration journey.
            </p>

        </div>


        <div class="row g-4">

            <!-- Professional Team -->
            <div class="col-md-6 col-lg-4 wow fadeInUp"
                 data-wow-delay="0.1s">

                <div class="bg-white rounded p-4 h-100 text-center">

                    <div class="btn-lg-square bg-primary rounded-circle mx-auto mb-4">

                        <i class="fa fa-user-tie fa-2x text-white"></i>

                    </div>

                    <h4 class="mb-3">
                        Professional Team
                    </h4>

                    <p class="mb-0">
                        Our experienced team provides practical guidance
                        and support throughout the immigration process.
                    </p>

                </div>

            </div>


            <!-- Personalized Approach -->
            <div class="col-md-6 col-lg-4 wow fadeInUp"
                 data-wow-delay="0.3s">

                <div class="bg-white rounded p-4 h-100 text-center">

                    <div class="btn-lg-square bg-primary rounded-circle mx-auto mb-4">

                        <i class="fa fa-users fa-2x text-white"></i>

                    </div>

                    <h4 class="mb-3">
                        Personalized Approach
                    </h4>

                    <p class="mb-0">
                        Every applicant is different, so we focus on
                        solutions that match your goals and circumstances.
                    </p>

                </div>

            </div>


            <!-- Dedicated Support -->
            <div class="col-md-6 col-lg-4 wow fadeInUp"
                 data-wow-delay="0.5s">

                <div class="bg-white rounded p-4 h-100 text-center">

                    <div class="btn-lg-square bg-primary rounded-circle mx-auto mb-4">

                        <i class="fa fa-headset fa-2x text-white"></i>

                    </div>

                    <h4 class="mb-3">
                        Dedicated Support
                    </h4>

                    <p class="mb-0">
                        We are here to answer your questions and help
                        you move forward with confidence.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Why Choose Us End -->
<!-- Mission Start -->
<div class="container-fluid py-5">

    <div class="container py-5">

        <div class="row g-5 align-items-center">

            <!-- Mission Content -->
            <div class="col-lg-6 wow fadeInLeft"
                 data-wow-delay="0.1s">

                <div class="section-title mb-4">

                    <div class="sub-style">

                        <h5 class="sub-title text-primary px-3">
                            OUR MISSION
                        </h5>

                    </div>

                    <h1 class="display-5 mb-4">
                        Making Immigration Simpler
                    </h1>

                </div>

                <p class="mb-4">
                    Our mission is to make the immigration process easier
                    to understand and less stressful for our clients.
                </p>

                <p class="mb-0">
                    From choosing the right immigration pathway to preparing
                    your application, we aim to provide the information and
                    support you need at every step.
                </p>

            </div>


            <!-- Mission CTA -->
            <div class="col-lg-6 wow fadeInRight"
                 data-wow-delay="0.3s">

                <div class="bg-primary rounded p-5">

                    <h3 class="text-white mb-4">
                        Start Your Immigration Journey
                    </h3>

                    <p class="text-white mb-4">
                        Have questions about your immigration options?
                        Contact our team and request a consultation.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="btn btn-light rounded-pill py-3 px-5">

                        Contact Us

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Mission End -->