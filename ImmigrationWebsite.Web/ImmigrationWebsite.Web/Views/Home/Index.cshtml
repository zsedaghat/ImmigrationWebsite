<!-- Countries We Offer Start -->
<div class="container-fluid country overflow-hidden py-5">
    <div class="container">

        <div class="section-title text-center wow fadeInUp"
             data-wow-delay="0.1s"
             style="margin-bottom: 70px;">

            <div class="sub-style">
                <h5 class="sub-title text-primary px-3">
                    COUNTRIES WE OFFER
                </h5>
            </div>

            <h1 class="display-5 mb-4">
                Immigration & Visa Services Following Countries
            </h1>

            <p class="mb-0">
                Explore the countries where we provide immigration
                and visa services.
            </p>

        </div>

        <div class="row g-4 text-center">

            @foreach (var country in Model.Countries)
            {
                <div class="col-lg-6 col-xl-3 mb-5 mb-xl-0 wow fadeInUp"
                     data-wow-delay="0.1s">

                    <div class="country-item">

                        <!-- Country Image -->
                        <div class="rounded overflow-hidden">

                            @if (!string.IsNullOrEmpty(country.ImageUrl))
                            {
                                <img src="@country.ImageUrl"
                                     class="img-fluid w-100 rounded"
                                     alt="@country.Name">
                            }
                            else
                            {
                                <img src="~/img/country-1.jpg"
                                     class="img-fluid w-100 rounded"
                                     alt="@country.Name">
                            }

                        </div>

                        <!-- Country Flag -->
                        <div class="country-flag">

                            @if (!string.IsNullOrEmpty(country.FlagImageUrl))
                            {
                                <img src="@country.FlagImageUrl"
                                     class="img-fluid rounded-circle"
                                     alt="@country.Name Flag">
                            }
                            else
                            {
                                <img src="~/img/default-flag.png"
                                     class="img-fluid rounded-circle"
                                     alt="@country.Name Flag">
                            }

                        </div>

                        <!-- Country Name -->
                        <div class="country-name">

                            <a asp-controller="Countries"
                               asp-action="Details"
                               asp-route-id="@country.Id"
                               class="text-white fs-4">

                                @country.Name

                            </a>

                        </div>

                    </div>

                </div>
            }

            <!-- More Countries -->
            <div class="col-12">

                <a asp-controller="Countries"
                   asp-action="Index"
                   class="btn btn-primary border-secondary rounded-pill py-3 px-5 wow fadeInUp"
                   data-wow-delay="0.1s">

                    More Countries

                </a>

            </div>

        </div>

    </div>
</div>
<!-- Countries We Offer End -->
