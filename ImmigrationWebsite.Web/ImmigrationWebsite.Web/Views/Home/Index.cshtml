
@model ImmigrationWebsite.Web.Models.ViewModels.HomeViewModel

<!-- =========================================================
     HERO / CAROUSEL START
     ========================================================= -->

<div class="carousel-header">
    <div id="carouselId"
         class="carousel slide"
         data-bs-ride="carousel">

        <ol class="carousel-indicators">
            <li data-bs-target="#carouselId"
                data-bs-slide-to="0"
                class="active">
            </li>

            <li data-bs-target="#carouselId"
                data-bs-slide-to="1">
            </li>
        </ol>


        <div class="carousel-inner" role="listbox">

            <!-- =================================================
                 SLIDE 1
                 ================================================= -->

            <div class="carousel-item active">

                <img src="~/img/carousel-1.jpg"
                     class="img-fluid"
                     alt="Canada and international opportunities">

                <div class="carousel-caption">

                    <div class="text-center p-4"
                         style="max-width: 900px;">

                        <h4 class="gb-hero-label text-uppercase fw-bold mb-3 mb-md-4 wow fadeInUp"
                            data-wow-delay="0.1s">
                            WELCOME TO GLOBAL BRIDGE
                        </h4>

                        <h1 class="display-1 text-capitalize text-white gb-hero-title mb-3 mb-md-4 wow fadeInUp"
                            data-wow-delay="0.3s">
                            Your Bridge to New Opportunities
                        </h1>

                        <p class="gb-hero-tagline mb-3 fs-5 fw-semibold wow fadeInUp"
                           data-wow-delay="0.4s">
                            Practical Support. Brighter Opportunities. Everywhere.
                        </p>

                        <p class="text-white mb-4 mb-md-5 fs-5 gb-hero-description wow fadeInUp"
                           data-wow-delay="0.5s">
                            Personalized administrative and practical support for
                            individuals, newcomers, students and families — from
                            applications and settlement to education, employment,
                            housing, documents and international travel.
                        </p>

                        <div class="d-flex justify-content-center flex-wrap gap-3 wow fadeInUp"
                             data-wow-delay="0.7s">

                            <a asp-controller="Services"
                               asp-action="Index"
                               class="btn btn-primary rounded-pill py-3 px-5 gb-hero-btn">
                                EXPLORE OUR SERVICES
                            </a>

                            <a asp-controller="Home"
                               asp-action="Contact"
                               class="btn btn-light rounded-pill py-3 px-5 gb-contact-btn">
                                CONTACT US
                            </a>

                        </div>

                    </div>

                </div>
            </div>


            <!-- =================================================
                 SLIDE 2
                 ================================================= -->

            <div class="carousel-item">

                <img src="~/img/carousel-2.jpg"
                     class="img-fluid"
                     alt="Global opportunities for families, students and professionals">

                <div class="carousel-caption">

                    <div class="text-center p-4"
                         style="max-width: 900px;">

                        <h4 class="gb-hero-label text-uppercase fw-bold mb-3 mb-md-4 wow fadeInUp"
                            data-wow-delay="0.1s">
                            WELCOME TO GLOBAL BRIDGE
                        </h4>

                        <h1 class="display-1 text-capitalize text-white gb-hero-title mb-3 mb-md-4 wow fadeInUp"
                            data-wow-delay="0.3s">
                            Your Bridge to New Opportunities
                        </h1>

                        <p class="gb-hero-tagline mb-3 fs-5 fw-semibold wow fadeInUp"
                           data-wow-delay="0.4s">
                            Practical Support. Brighter Opportunities. Everywhere.
                        </p>

                        <p class="text-white mb-4 mb-md-5 fs-5 gb-hero-description wow fadeInUp"
                           data-wow-delay="0.5s">
                            Personalized administrative and practical support for
                            individuals, newcomers, students and families — from
                            applications and settlement to education, employment,
                            housing, documents and international travel.
                        </p>

                        <div class="d-flex justify-content-center flex-wrap gap-3 wow fadeInUp"
                             data-wow-delay="0.7s">

                            <a asp-controller="Services"
                               asp-action="Index"
                               class="btn btn-primary rounded-pill py-3 px-5 gb-hero-btn">
                                EXPLORE OUR SERVICES
                            </a>

                            <a asp-controller="Home"
                               asp-action="Contact"
                               class="btn btn-light rounded-pill py-3 px-5 gb-contact-btn">
                                CONTACT US
                            </a>

                        </div>

                    </div>

                </div>
            </div>

        </div>


        <!-- =================================================
             CAROUSEL CONTROLS
             ================================================= -->

        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#carouselId"
                data-bs-slide="prev">

            <span class="carousel-control-prev-icon bg-secondary wow fadeInLeft"
                  data-wow-delay="0.2s">
            </span>

            <span class="visually-hidden">
                Previous
            </span>

        </button>


        <button class="carousel-control-next"
                type="button"
                data-bs-target="#carouselId"
                data-bs-slide="next">

            <span class="carousel-control-next-icon bg-secondary wow fadeInRight"
                  data-wow-delay="0.2s">
            </span>

            <span class="visually-hidden">
                Next
            </span>

        </button>

    </div>
</div>

<!-- Carousel End -->
<!-- =========================================================
     SERVICES START
     ========================================================= -->

<div class="container-fluid service overflow-hidden pt-5">


    <div class="container py-5">

        <div class="section-title text-center mb-5 wow fadeInUp"
             data-wow-delay="0.1s">

            <div class="sub-style">

                <h5 class="sub-title text-primary px-3">
                    OUR SERVICES
                </h5>

            </div>

            <h1 class="display-5 mb-4">
                How Can We Help?
            </h1>

            <p class="mb-0">
                Practical support for many of life's important steps — all in one place.
            </p>

        </div>


        <div class="row g-4">

            @{
                var excludedSlugs = new[]
                {
                        "canada",
                        "travel-visas",
                        "education",
                        "resources"
                        };
            }

            @foreach (var service in Model.Services.Where(x =>
                        x.Slug == null || !excludedSlugs.Contains(x.Slug)))
            {
                <div class="col-lg-6 col-xl-4 wow fadeInUp"
                     data-wow-delay="0.1s">

                    <div class="service-item">

                        <div class="service-inner">

                            <!-- SERVICE IMAGE -->

                            <div class="service-img">

                                @if (!string.IsNullOrEmpty(service.ImageUrl))
                                {
                                    <img src="@service.ImageUrl"
                                         class="img-fluid w-100 rounded service-card-image"
                                         alt="@service.Title">
                                }
                                else
                                {
                                    <img src="~/img/service-1.jpg"
                                         class="img-fluid w-100 rounded"
                                         alt="@service.Title">
                                }

                            </div>


                            <!-- SERVICE TITLE -->

                            <div class="service-title">

                                <div class="service-title-name">

                                    <div class="bg-primary text-center rounded p-3 mx-5 mb-4">

                                        <a href="/services/@service.Id"
                                           class="h4 text-white mb-0">

                                            @service.Title

                                        </a>

                                    </div>


                                    <a href="/services/@service.Id"
                                       class="btn bg-light text-secondary rounded-pill py-3 px-5 mb-4">

                                        LEARN MORE

                                    </a>

                                </div>


                                <!-- SERVICE CONTENT -->

                                <div class="service-content pb-4">

                                    <a href="/services/@service.Id">

                                        <h4 class="text-white mb-4 py-3">
                                            @service.Title
                                        </h4>

                                    </a>


                                    <div class="px-4">

                                        <p class="mb-4">
                                            @service.Description
                                        </p>

                                        <a href="/services/@service.Id"
                                           class="btn btn-primary border-secondary rounded-pill py-3 px-5">

                                            LEARN MORE

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>


</div>

<!-- Services End -->
<!-- =========================================================
     ABOUT START
     ========================================================= -->

<div class="container-fluid py-5">

    <div class="container py-5">

        <div class="row g-5 align-items-center">


            <!-- IMAGE -->

            <div class="col-xl-5 wow fadeInLeft"
                 data-wow-delay="0.1s">

                <div class="bg-light rounded overflow-hidden">

                    <img src="~/img/about-2.jpg"
                         class="img-fluid w-100"
                         alt="Global Bridge Support Services">

                </div>

            </div>


            <!-- CONTENT -->

            <div class="col-xl-7 wow fadeInRight"
                 data-wow-delay="0.3s">

                <h5 class="sub-title pe-3">
                    ABOUT GLOBAL BRIDGE
                </h5>


                <h1 class="display-5 mb-4">
                    More Than Forms. Support for the Journey Ahead.
                </h1>


                <p class="mb-4">
                    Global Bridge Support Services provides personalized administrative
                    and practical assistance to individuals and families navigating
                    important processes in Canada and internationally.
                </p>


                <p class="mb-4">
                    From organizing applications and documents to settlement, education,
                    employment, housing, travel and everyday services, our goal is to make
                    complicated processes easier to understand and manage.
                </p>


                <p class="mb-4">
                    Our approach is personal and practical. We work with clients step
                    by step, helping them stay organized, informed and prepared
                    throughout the administrative process.
                </p>


                <a asp-controller="Home"
                   asp-action="About"
                   class="btn btn-primary border-secondary rounded-pill py-3 px-5">

                    ABOUT GLOBAL BRIDGE

                </a>

            </div>

        </div>

    </div>

</div>

<!-- About End -->
<!-- =========================================================
     COUNTRIES START
     ========================================================= -->

<div class="container-fluid country overflow-hidden py-5">

    <div class="container">


        <div class="section-title text-center wow fadeInUp"
             data-wow-delay="0.1s"
             style="margin-bottom: 70px;">

            <div class="sub-style">

                <h5 class="sub-title text-primary px-3">
                    COUNTRIES WE OFFER
                </h5>

            </div>


            <h1 class="display-5 mb-4">
                Support Across Countries
            </h1>


            <p class="mb-0">
                Explore the countries and destinations where Global Bridge
                provides practical administrative and travel support.
            </p>

        </div>


        <div class="row g-4 text-center">


            @foreach (var country in Model.Countries)
            {
                <div class="col-lg-6 col-xl-3 mb-5 mb-xl-0 wow fadeInUp"
                     data-wow-delay="0.1s">

                    <div class="country-item">


                        <!-- COUNTRY IMAGE -->

                        <div class="rounded overflow-hidden">

                            @if (!string.IsNullOrEmpty(country.ImageUrl))
                            {
                                <img src="@country.ImageUrl"
                                     class="img-fluid w-100 rounded"
                                     alt="@country.Name">
                            }
                            else
                            {
                                <img src="~/img/country-1.jpg"
                                     class="img-fluid w-100 rounded"
                                     alt="@country.Name">
                            }

                        </div>


                        <!-- COUNTRY FLAG -->
                        @if (!string.IsNullOrEmpty(country.FlagImageUrl))
                        {
                            <div class="country-flag">

                                <img src="@country.FlagImageUrl"
                                     class="img-fluid rounded-circle"
                                     alt="@country.Name Flag">

                            </div>
                        }


                        <!-- COUNTRY NAME -->

                        <div class="country-name">

                            <a asp-controller="Countries"
                               asp-action="Details"
                               asp-route-id="@country.Id"
                               class="text-white fs-4">

                                @country.Name

                            </a>

                        </div>

                    </div>

                </div>
            }


            <!-- MORE COUNTRIES -->

            <div class="col-12">

                <a asp-controller="Countries"
                   asp-action="Index"
                   class="btn btn-primary border-secondary rounded-pill py-3 px-5 wow fadeInUp"
                   data-wow-delay="0.1s">

                    MORE COUNTRIES

                </a>

            </div>

        </div>

    </div>

</div>

<!-- Countries End -->
<!-- =========================================================
     WHY GLOBAL BRIDGE START
     ========================================================= -->

<div class="container-fluid features overflow-hidden py-5">

    <div class="container">


        <div class="section-title text-center mb-5 wow fadeInUp"
             data-wow-delay="0.1s">

            <div class="sub-style">

                <h5 class="sub-title text-primary px-3">
                    WHY GLOBAL BRIDGE?
                </h5>

            </div>


            <h1 class="display-5 mb-4">
                Practical Help. Personal Attention.
            </h1>


            <p class="mb-0">
                We provide practical, personalized support to help you
                understand and manage important administrative processes.
            </p>

        </div>


        <div class="row g-4 justify-content-center text-center">


            <!-- PERSONALIZED SUPPORT -->

            <div class="col-md-6 col-lg-6 col-xl-4 wow fadeInUp"
                 data-wow-delay="0.1s">

                <div class="feature-item text-center p-4 h-100">

                    <div class="feature-icon p-3 mb-4">

                        <i class="fas fa-user-check fa-4x text-primary"></i>

                    </div>


                    <div class="feature-content d-flex flex-column">

                        <h5 class="mb-3">
                            PERSONALIZED SUPPORT
                        </h5>

                        <p class="mb-0">
                            Every client's needs and circumstances are different.
                        </p>

                    </div>

                </div>

            </div>


            <!-- STEP-BY-STEP -->

            <div class="col-md-6 col-lg-6 col-xl-4 wow fadeInUp"
                 data-wow-delay="0.3s">

                <div class="feature-item text-center p-4 h-100">

                    <div class="feature-icon p-3 mb-4">

                        <i class="fas fa-tasks fa-4x text-primary"></i>

                    </div>


                    <div class="feature-content d-flex flex-column">

                        <h5 class="mb-3">
                            STEP-BY-STEP ASSISTANCE
                        </h5>

                        <p class="mb-0">
                            We make administrative processes easier to understand and manage.
                        </p>

                    </div>

                </div>

            </div>


            <!-- MANY SERVICES -->

            <div class="col-md-6 col-lg-6 col-xl-4 wow fadeInUp"
                 data-wow-delay="0.5s">

                <div class="feature-item text-center p-4 h-100">

                    <div class="feature-icon p-3 mb-4">

                        <i class="fas fa-layer-group fa-4x text-primary"></i>

                    </div>


                    <div class="feature-content d-flex flex-column">

                        <h5 class="mb-3">
                            MANY SERVICES, ONE PLACE
                        </h5>

                        <p class="mb-0">
                            From applications and housing to education,
                            employment and everyday life.
                        </p>

                    </div>

                </div>

            </div>


            <!-- CONTINUED SUPPORT -->

            <div class="col-md-6 col-lg-6 col-xl-4 wow fadeInUp"
                 data-wow-delay="0.1s">

                <div class="feature-item text-center p-4 h-100">

                    <div class="feature-icon p-3 mb-4">

                        <i class="fas fa-hands-helping fa-4x text-primary"></i>

                    </div>


                    <div class="feature-content d-flex flex-column">

                        <h5 class="mb-3">
                            CONTINUED SUPPORT
                        </h5>

                        <p class="mb-0">
                            We're here for more than one application or one stage
                            of your journey.
                        </p>

                    </div>

                </div>

            </div>


            <!-- CANADA & INTERNATIONAL -->

            <div class="col-md-6 col-lg-6 col-xl-4 wow fadeInUp"
                 data-wow-delay="0.3s">

                <div class="feature-item text-center p-4 h-100">

                    <div class="feature-icon p-3 mb-4">

                        <i class="fas fa-globe-americas fa-4x text-primary"></i>

                    </div>


                    <div class="feature-content d-flex flex-column">

                        <h5 class="mb-3">
                            CANADA &amp; INTERNATIONAL
                        </h5>

                        <p class="mb-0">
                            Practical assistance at home and support for opportunities abroad.
                        </p>

                    </div>

                </div>

            </div>


            <!-- MULTILINGUAL -->

            <div class="col-md-6 col-lg-6 col-xl-4 wow fadeInUp"
                 data-wow-delay="0.5s">

                <div class="feature-item text-center p-4 h-100">

                    <div class="feature-icon p-3 mb-4">

                        <i class="fas fa-language fa-4x text-primary"></i>

                    </div>


                    <div class="feature-content d-flex flex-column">

                        <h5 class="mb-3">
                            MULTILINGUAL SUPPORT
                        </h5>

                        <p class="mb-0">
                            Support available in the languages provided by Global Bridge.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- Why Global Bridge End -->
<!-- =========================================================
     TESTIMONIALS / REVIEWS START
     ========================================================= -->
@if (Model.Reviews != null && Model.Reviews.Any())
{
    <div class="container-fluid testimonial overflow-hidden pb-5">

        <div class="container py-5">


            <div class="section-title text-center mb-5 wow fadeInUp"
                 data-wow-delay="0.1s">

                <div class="sub-style">

                    <h5 class="sub-title text-primary px-3">
                        CLIENT REVIEWS
                    </h5>

                </div>


                <h1 class="display-5 mb-4">
                    What Our Clients Say
                </h1>


                <p class="mb-0">
                    Hear from people who have experienced the practical support
                    provided by Global Bridge.
                </p>

            </div>


            <div class="owl-carousel testimonial-carousel wow zoomInDown"
                 data-wow-delay="0.2s">


                @foreach (var review in Model.Reviews)
                {
                    <div class="testimonial-item">


                        <!-- REVIEW CONTENT -->

                        <div class="testimonial-content p-4 mb-5">


                            <div style="
                                        height:120px;
                                        overflow-y:auto;
                                        padding-right:10px;
                                        text-align:left;
                                    ">

                                <p class="fs-5 mb-0">
                                    @review.Comment
                                </p>

                            </div>


                            <!-- STARS -->

                            <div class="d-flex justify-content-end">

                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <i class="fas fa-star text-secondary"></i>
                                }

                            </div>

                        </div>


                        <!-- REVIEW AUTHOR -->

                        <div class="d-flex">

                            <div class="rounded-circle me-4"
                                 style="width:100px;height:100px;">

                                @if (!string.IsNullOrEmpty(review.ImageUrl))
                                {
                                    <img class="img-fluid rounded-circle"
                                         src="@review.ImageUrl"
                                         alt="@review.Name">
                                }
                                else
                                {
                                    <img class="img-fluid rounded-circle"
                                         src="~/img/testimonial-1.jpg"
                                         alt="@review.Name">
                                }

                            </div>


                            <div class="my-auto">

                                <h5>
                                    @review.Name
                                </h5>

                                <p class="mb-0">
                                    @review.Country
                                </p>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>
}


<!-- =========================================================
     ADD REVIEW
     ========================================================= -->

<div class="text-center mt-5 mb-5 wow fadeInUp"
     data-wow-delay="0.2s">

    <a asp-controller="Reviews"
       asp-action="Create"
       class="btn btn-primary border-secondary rounded-pill py-3 px-5">

        ADD YOUR REVIEW

    </a>

</div>

<!-- Testimonial End -->
