@model ImmigrationWebsite.Web.Models.ConsultationRequest

@{
    ViewData["Title"] = "Contact Us";
}

<!-- Page Header Start -->
<div class="container-fluid page-header py-5"
     style="background: linear-gradient(rgba(0, 0, 0, .55), rgba(0, 0, 0, .55)), url('/img/office-3.jpg') center center / cover no-repeat;">

    <div class="container py-5">

        <h1 class="display-3 text-white mb-3 internal-page-title">
            Contact Us
        </h1>

        <p class="text-white mb-0 internal-page-subtitle">
            Get in touch with us and take the first step toward your immigration journey.
        </p>

    </div>

</div>
<!-- Page Header End -->
<!-- Contact Start -->
<div class="container-fluid py-5">

    <div class="container py-5">

        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-5"
                 role="alert">

                <i class="fa fa-check-circle me-2"></i>

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- Title -->
        <div class="text-center mx-auto mb-5"
             style="max-width: 700px;">

            <h5 class="text-primary text-uppercase">
                Contact Us
            </h5>

            <h1 class="display-5 mb-3">
                We Are Here To Help You
            </h1>

            <p class="mb-0">
                Have questions about immigration?
                Get in touch with our team and request a consultation.
            </p>

        </div>


        <div class="row g-5">

            <!-- Contact Information -->
            <div class="col-lg-5">

                <h3 class="mb-4">
                    Get In Touch
                </h3>


                <!-- Address -->
                <div class="d-flex mb-4">

                    <div class="flex-shrink-0 btn-lg-square bg-primary text-white">
                        <i class="fa fa-map-marker-alt"></i>
                    </div>

                    <div class="ms-3">

                        <h5>
                            Our Office
                        </h5>

                        <p class="mb-0">
                            Your Office Address
                        </p>

                    </div>

                </div>


                <!-- Phone -->
                <div class="d-flex mb-4">

                    <div class="flex-shrink-0 btn-lg-square bg-primary text-white">
                        <i class="fa fa-phone-alt"></i>
                    </div>

                    <div class="ms-3">

                        <h5>
                            Call Us
                        </h5>

                        <p class="mb-0">
                            +00 123 456 789
                        </p>

                    </div>

                </div>


                <!-- Email -->
                <div class="d-flex mb-4">

                    <div class="flex-shrink-0 btn-lg-square bg-primary text-white">
                        <i class="fa fa-envelope"></i>
                    </div>

                    <div class="ms-3">

                        <h5>
                            Email Us
                        </h5>

                        <p class="mb-0">
                            info@example.com
                        </p>

                    </div>

                </div>


                <!-- Working Hours -->
                <div class="d-flex mb-4">

                    <div class="flex-shrink-0 btn-lg-square bg-primary text-white">
                        <i class="fa fa-clock"></i>
                    </div>

                    <div class="ms-3">

                        <h5>
                            Working Hours
                        </h5>

                        <p class="mb-0">
                            Monday - Friday
                            <br />
                            9:00 AM - 6:00 PM
                        </p>

                    </div>

                </div>


                <!-- Social Media -->
                <div class="mt-5">

                    <h5 class="mb-3">
                        Follow Us
                    </h5>

                    <div class="d-flex">

                        <a class="btn btn-primary btn-square me-2"
                           href="#"
                           aria-label="Facebook">

                            <i class="fab fa-facebook-f"></i>

                        </a>

                        <a class="btn btn-primary btn-square me-2"
                           href="#"
                           aria-label="Instagram">

                            <i class="fab fa-instagram"></i>

                        </a>

                        <a class="btn btn-primary btn-square me-2"
                           href="#"
                           aria-label="LinkedIn">

                            <i class="fab fa-linkedin-in"></i>

                        </a>

                    </div>

                </div>

            </div>


            <!-- Consultation Form -->
            <div class="col-lg-7">

                <div class="bg-light p-4 p-md-5">

                    <div class="mb-4">

                        <h3 class="mb-2">
                            Request a Consultation
                        </h3>

                        <p class="mb-0 text-muted">
                            Fill out the form below and our team will contact you.
                        </p>

                    </div>


                    <form asp-controller="Home"
                          asp-action="Contact"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="row g-3">

                            <!-- Full Name -->
                            <div class="col-md-6">

                                <label asp-for="FullName"
                                       class="form-label">
                                    Full Name
                                </label>

                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Your Full Name" />

                                <span asp-validation-for="FullName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Email -->
                            <div class="col-md-6">

                                <label asp-for="Email"
                                       class="form-label">
                                    Email Address
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="Your Email Address" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Phone -->
                            <div class="col-md-6">

                                <label asp-for="Phone"
                                       class="form-label">
                                    Phone Number
                                </label>

                                <input asp-for="Phone"
                                       class="form-control"
                                       placeholder="Your Phone Number" />

                                <span asp-validation-for="Phone"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Country -->
                            <div class="col-md-6">

                                <label asp-for="Country"
                                       class="form-label">
                                    Destination Country
                                </label>

                                <input asp-for="Country"
                                       class="form-control"
                                       placeholder="e.g. Canada, Germany, Australia" />

                                <span asp-validation-for="Country"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Service -->
                            <div class="col-12">

                                <label asp-for="Service"
                                       class="form-label">
                                    Service
                                </label>

                                <input asp-for="Service"
                                       class="form-control"
                                       placeholder="e.g. Study Visa, Work Visa, Immigration Consulting" />

                                <span asp-validation-for="Service"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Message -->
                            <div class="col-12">

                                <label asp-for="Message"
                                       class="form-label">
                                    Message
                                </label>

                                <textarea asp-for="Message"
                                          class="form-control"
                                          rows="6"
                                          placeholder="Tell us about your immigration plans..."></textarea>

                                <span asp-validation-for="Message"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Submit Button -->
                            <div class="col-12">

                                <button type="submit"
                                        class="btn btn-primary w-100 py-3">

                                    <i class="fa fa-paper-plane me-2"></i>

                                    Submit Consultation Request

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Contact End -->
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}


