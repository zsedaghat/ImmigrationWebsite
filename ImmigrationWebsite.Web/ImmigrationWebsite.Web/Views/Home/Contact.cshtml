@model ImmigrationWebsite.Web.Models.ConsultationRequest

@{
    ViewData["Title"] = "Contact Us";
}

<!-- Contact Hero Start -->
<div class="container-fluid page-header py-5"
     style="background: linear-gradient(rgba(11, 27, 51, .78), rgba(20, 41, 75, .78)), url('/img/aboutUs.jpeg') center center / cover no-repeat;">

    <div class="container py-5">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <div class="sub-style mb-3">
                    <h5 class="sub-title px-3 text-white">
                        CONTACT US
                    </h5>
                </div>

                <h1 class="display-3 text-white mb-3 internal-page-title">
                    Let's Start a Conversation
                </h1>

                <p class="text-white fs-5 mb-0 internal-page-subtitle">
                    Tell us what you need help with. We're here to provide
                    practical support and help you take your next step.
                </p>

            </div>

        </div>

    </div>

</div>
<!-- Contact Hero End -->
<!-- Contact Start -->
<div class="container-fluid py-5 contact-page">

    <div class="container py-5">

        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-5 shadow-sm"
                 role="alert">

                <i class="fa fa-check-circle me-2"></i>

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- Section Heading -->
        <div class="section-title text-center mx-auto mb-5"
             style="max-width: 750px;">

            <div class="sub-style">
                <h5 class="sub-title px-3">
                    GET IN TOUCH
                </h5>
            </div>

            <h1 class="display-5 mb-3">
                How Can We Help?
            </h1>

            <p class="mb-0">
                Whether you have a question, need support with a service,
                or simply want to understand your options, we're here to help.
            </p>

        </div>


        <div class="row g-5 align-items-stretch">

            <!-- LEFT SIDE -->
            <div class="col-lg-5">

                <div class="contact-info-card h-100">

                    <div class="mb-4">

                        <span class="contact-label">
                            GLOBAL BRIDGE
                        </span>

                        <h2 class="mt-2 mb-3">
                            Support When You Need It
                        </h2>

                        <p>
                            Global Bridge Support Services provides practical
                            administrative and support services for individuals,
                            newcomers, students, families and businesses in Canada
                            and internationally.
                        </p>

                    </div>


                    <!-- Email -->
                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="fa fa-envelope"></i>
                        </div>

                        <div>
                            <span>Email Us</span>

                            <a href="mailto:info@globalbridgesupport.com">
                                info@globalbridgesupport.com
                            </a>
                        </div>

                    </div>


                    <!-- Website -->
                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="fa fa-globe"></i>
                        </div>

                        <div>
                            <span>Website</span>

                            <a href="https://globalbridgesupport.com"
                               target="_blank"
                               rel="noopener noreferrer">
                                globalbridgesupport.com
                            </a>
                        </div>

                    </div>


                    <!-- Support -->
                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="fa fa-comments"></i>
                        </div>

                        <div>
                            <span>Need Support?</span>

                            <p class="mb-0">
                                Complete the form and tell us what you need.
                            </p>
                        </div>

                    </div>


                    <!-- Social Media -->
                    <div class="contact-social mt-5">

                        <h5 class="mb-3">
                            Connect With Us
                        </h5>

                        <div class="d-flex gap-2">

                            <!-- Instagram -->
                            <a href="https://www.instagram.com/globalbridge_sup/"
                               class="btn btn-primary btn-square"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="Instagram">

                                <i class="fab fa-instagram"></i>

                            </a>
                        </div>

                    </div>

                </div>

            </div>


            <!-- RIGHT SIDE - FORM -->
            <div class="col-lg-7">

                <div class="contact-form-wrapper h-100">

                    <div class="mb-4">

                        <span class="contact-label">
                            REQUEST SUPPORT
                        </span>

                        <h2 class="mt-2 mb-2">
                            Tell Us How We Can Help
                        </h2>

                        <p>
                            Please complete the form below and provide a few
                            details so we can better understand how to support you.
                        </p>

                    </div>


                    <form asp-controller="Home"
                          asp-action="Contact"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="row g-3">

                            <!-- Full Name -->
                            <div class="col-md-6">

                                <label asp-for="FullName"
                                       class="form-label">
                                    Full Name
                                </label>

                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Your Full Name" />

                                <span asp-validation-for="FullName"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Email -->
                            <div class="col-md-6">

                                <label asp-for="Email"
                                       class="form-label">
                                    Email Address
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="Your Email Address" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Phone -->
                            <div class="col-md-6">

                                <label asp-for="Phone"
                                       class="form-label">
                                    Phone / WhatsApp
                                </label>

                                <input asp-for="Phone"
                                       class="form-control"
                                       placeholder="Your Phone or WhatsApp Number" />

                                <span asp-validation-for="Phone"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Country -->
                            <div class="col-md-6">

                                <label asp-for="Country"
                                       class="form-label">
                                    Current Country
                                </label>

                                <input asp-for="Country"
                                       class="form-control"
                                       placeholder="Where are you currently located?" />

                                <span asp-validation-for="Country"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Service -->
                            <div class="col-12">

                                <label asp-for="Service"
                                       class="form-label">
                                    Service Needed
                                </label>

                                <input asp-for="Service"
                                       class="form-control"
                                       placeholder="What service do you need help with?" />

                                <span asp-validation-for="Service"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Message -->
                            <div class="col-12">

                                <label asp-for="Message"
                                       class="form-label">
                                    Message
                                </label>

                                <textarea asp-for="Message"
                                          class="form-control"
                                          rows="5"
                                          placeholder="Tell us how we can help..."></textarea>

                                <span asp-validation-for="Message"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Submit -->
                            <div class="col-12 pt-2">

                                <button type="submit"
                                        class="btn btn-primary w-100 py-3">

                                    <i class="fa fa-paper-plane me-2"></i>

                                    SEND REQUEST

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Contact End -->
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}