@model ImmigrationWebsite.Web.Models.Pagination.PagedResult<ImmigrationWebsite.Web.Models.BlogPost>

@{
    ViewData["Title"] = "Resources";
}

<!-- =========================================================
     PAGE HEADER START
     ========================================================= -->

<div class="container-fluid page-header py-5"
     style="background: linear-gradient(rgba(0, 0, 0, .55), rgba(0, 0, 0, .55)), url('/img/blogpostindex.jpeg') center center / cover no-repeat;">

    <div class="container py-5">

        <h1 class="display-3 text-white mb-3 internal-page-title">
            Resources
        </h1>

        <p class="text-white mb-0 internal-page-subtitle">
            Helpful information, practical guides and useful resources.
        </p>

    </div>

</div>

<!-- Page Header End -->
<!-- =========================================================
     RESOURCES / ARTICLES START
     ========================================================= -->

<div class="container-fluid blog py-5">

    <div class="container py-5">


        <!-- SECTION TITLE -->

        <div class="section-title text-center mb-5 wow fadeInUp"
             data-wow-delay="0.1s">

            <div class="sub-style">

                <h5 class="sub-title text-primary px-3">
                    RESOURCES
                </h5>

            </div>


            <h1 class="display-5 mb-4">
                Helpful Information & Articles
            </h1>


            <p class="mb-0">
                Explore practical information, helpful guides and useful resources
                to help you better understand important processes and everyday needs.
            </p>

        </div>


        <!-- ARTICLES -->

        <div class="row g-4">

            @foreach (var post in Model.Items)
            {
                <div class="col-lg-6 col-xl-4 wow fadeInUp"
                     data-wow-delay="0.1s">

                    <div class="blog-item h-100">


                        <!-- ARTICLE IMAGE -->

                        <div class="blog-img">

                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                <img src="@post.ImageUrl"
                                     class="img-fluid w-100"
                                     alt="@post.Title">
                            }
                            else
                            {
                                <img src="~/img/blog-1.jpg"
                                     class="img-fluid w-100"
                                     alt="@post.Title">
                            }

                        </div>


                        <!-- ARTICLE CONTENT -->

                        <div class="blog-content p-4 d-flex flex-column">


                            <!-- DATE -->

                            <div class="d-flex justify-content-between mb-3">

                                <small class="text-primary">

                                    <i class="fas fa-calendar-alt me-2"></i>

                                    @post.PublishedAt.ToString("MMM dd, yyyy")

                                </small>

                            </div>


                            <!-- TITLE -->

                            <h4 class="mb-3">
                                @post.Title
                            </h4>


                            <!-- SUMMARY -->
                            @if (!string.IsNullOrEmpty(post.Summary))
                            {
                                <p class="mb-4">
                                    @post.Summary
                                </p>
                            }


                            <!-- READ MORE -->

                            <div class="mt-auto">

                                <a asp-controller="Blog"
                                   asp-action="Details"
                                   asp-route-id="@post.Id"
                                   class="btn btn-primary rounded-pill py-2 px-4">

                                    READ MORE

                                    <i class="fas fa-arrow-right ms-2"></i>

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- =================================================
             PAGINATION
             ================================================= -->
        @if (Model.TotalPages > 1)
        {
            <div class="col-12 mt-5">

                <nav aria-label="Resources pagination">

                    <ul class="pagination justify-content-center">


                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">

                                <a class="page-link"
                                   asp-controller="Blog"
                                   asp-action="Index"
                                   asp-route-page="@(Model.PageNumber - 1)">

                                    Previous

                                </a>

                            </li>
                        }


                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">

                                <a class="page-link"
                                   asp-controller="Blog"
                                   asp-action="Index"
                                   asp-route-page="@i">

                                    @i

                                </a>

                            </li>
                        }


                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">

                                <a class="page-link"
                                   asp-controller="Blog"
                                   asp-action="Index"
                                   asp-route-page="@(Model.PageNumber + 1)">

                                    Next

                                </a>

                            </li>
                        }

                    </ul>

                </nav>

            </div>
        }

    </div>


</div>

<!-- Resources / Articles End -->
