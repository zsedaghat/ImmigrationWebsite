@model ImmigrationWebsite.Web.Models.BlogPost

@{
    ViewData["Title"] = Model.Title;
}

<!-- =========================================================
     PAGE HEADER START
     ========================================================= -->

<div class="container-fluid page-header py-5"
     style="background: linear-gradient(rgba(0, 0, 0, .55), rgba(0, 0, 0, .55)), url('/img/blogpostPic.jpg') center center / cover no-repeat;">


    <div class="container py-5">

        <h1 class="display-3 text-white mb-3 internal-page-title">
            Resources
        </h1>

        <p class="text-white mb-0 internal-page-subtitle">
            Helpful information, practical guides and useful resources.
        </p>

    </div>


</div>

<!-- Page Header End -->
<!-- =========================================================
     ARTICLE DETAILS START
     ========================================================= -->

<div class="container-fluid py-5">


    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-9">


                <!-- =================================================
                     ARTICLE IMAGE
                     ================================================= -->
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-4 wow fadeInDown"
                         data-wow-delay="0.2s">

                        <img src="@Model.ImageUrl"
                             class="img-fluid w-100 rounded"
                             alt="@Model.Title">

                    </div>
                }


                <!-- =================================================
                     ARTICLE META
                     ================================================= -->

                <div class="mb-3 wow fadeInDown"
                     data-wow-delay="0.3s">

                    <span class="text-primary">

                        <i class="fas fa-calendar-alt me-2"></i>

                        @Model.PublishedAt.ToString("MMMM dd, yyyy")

                    </span>

                </div>


                <!-- =================================================
                     ARTICLE TITLE
                     ================================================= -->

                <h1 class="display-5 mb-4 wow fadeInDown"
                    data-wow-delay="0.4s">

                    @Model.Title

                </h1>


                <!-- =================================================
                     ARTICLE SUMMARY
                     ================================================= -->
                @if (!string.IsNullOrEmpty(Model.Summary))
                {
                    <p class="lead mb-4 wow fadeInDown"
                       data-wow-delay="0.5s">

                        @Model.Summary

                    </p>
                }


                <!-- =================================================
                     ARTICLE CONTENT
                     ================================================= -->

                <div class="blog-details-content wow fadeInDown"
                     data-wow-delay="0.6s">

                    @Html.Raw(Model.Content)

                </div>


                <!-- =================================================
                     BACK TO RESOURCES
                     ================================================= -->

                <div class="mt-5 wow fadeInDown"
                     data-wow-delay="0.7s">

                    <a asp-controller="Blog"
                       asp-action="Index"
                       class="btn btn-primary border-secondary rounded-pill py-3 px-5">

                        <i class="fas fa-arrow-left me-2"></i>

                        BACK TO RESOURCES

                    </a>

                </div>


            </div>

        </div>

    </div>
    

</div>

<!-- Article Details End -->
